#!/bin/sh
# openfortitray-tunnel — root-owned privileged helper for the openfortitray tray app.
#
# Installed by scripts/install.sh as /usr/local/libexec/openfortitray-tunnel
# (owner root, mode 0755, in a root-owned directory). The sudoers rule written by
# the installer grants NOPASSWD for *this path only*, never for openconnect
# itself: a bare NOPASSWD on openconnect would let any local process run
# arbitrary code as root via openconnect's own --script/--csd-wrapper options.
#
# Two reasons this helper exists at all:
#
#  1. Teardown. openconnect must run as root, so the unprivileged tray app
#     cannot signal it (kill(2) returns EPERM) — the tunnel and its routes would
#     leak until something killed sudo, which does not restore routing. The app
#     therefore asks for teardown through "stop", which runs as root and can
#     deliver SIGINT.
#  2. Attack surface. Everything reachable with NOPASSWD is confined to the two
#     subcommands below, with the gateway argument validated, and every extra
#     openconnect flag checked against a fixed allowlist, before anything is
#     handed to openconnect.
#
# THREAT MODEL — read before widening anything here.
#
#   Argument injection: blocked on both platforms. The gateway is validated
#   against a strict host:port pattern, and every remaining argument to "start"
#   is validated against an EXACT allowlist, before openconnect is reached. A
#   local caller cannot smuggle --script=/--csd-wrapper= (which openconnect would
#   run as root) through the NOPASSWD rule.
#
#   Flag allowlist: "start" no longer forbids ALL openconnect options — it
#   forbids all EXCEPT three vetted, argument-validated flags that shape the
#   tunnel and CANNOT lead to code execution:
#     --no-dtls        boolean; disables DTLS/ESP. Takes no argument.
#     --disable-ipv6   boolean; forces IPv4-only. Takes no argument.
#     --servercert FP  pins the server certificate to fingerprint FP. It takes
#                      only a fingerprint — never a script, command or path that
#                      openconnect could execute — and FP itself is validated
#                      against a strict charset/length (see validate_fingerprint),
#                      so a value like "--servercert /tmp/evil" or a fingerprint
#                      that smuggles a shell metacharacter is refused.
#   Everything else — any other flag, any --script/--csd-wrapper/-o/--, any bare
#   "-x", a "--servercert" with no valid fingerprint following it — is rejected
#   (die, non-zero, no exec). None of the three allowlisted flags takes a
#   payload openconnect runs, which is what keeps the "no arbitrary root code
#   execution" guarantee intact while letting the Advanced toggles work.
#   The flags are validated as SEPARATE argv elements (sudo/exec pass them
#   through without a shell), so a fingerprint value can never be re-parsed as an
#   option, and the sudoers match is on the helper path only — argv does not
#   affect it, so no sudoers change was needed to widen "start".
#
#   Binary tampering: blocked on Linux, only WARNED ABOUT on macOS. The
#   openconnect path is baked in at install time rather than resolved through
#   PATH, and checked at run time, because a passwordless-root helper that
#   resolves its payload through a writable directory is a root exploit, not a
#   helper. On Linux the installer refuses to proceed unless the binary and every
#   ancestor directory are root-owned and not group/other-writable, so this
#   boundary holds. On macOS, Homebrew's prefix (/opt/homebrew, /usr/local) is
#   owned by the installing user *by design*: anyone who can write there could
#   replace openconnect and gain root through this rule. We warn loudly and
#   continue, because on a single-user mac that user is already an admin who can
#   run sudo directly, so the helper grants them nothing new. This is a
#   documented limit of the design, not a property we claim to enforce. On a
#   multi-user mac, install openconnect somewhere root-owned and point the
#   installer at it.
#
# Usage (as invoked by the app via `sudo -n`):
#   openfortitray-tunnel start <host:port> [flag ...]  # exec openconnect,
#                                                        cookie on stdin
#     where each flag is one of the allowlisted:
#       --no-dtls | --disable-ipv6 | --servercert <fingerprint>
#   openfortitray-tunnel stop                          # SIGINT the running openconnect
set -eu

# Fixed PATH for the coreutils this script itself calls (cat, ps, kill, rm,
# sleep, find). System directories only: the caller's environment must never
# influence what runs as root, and package-manager prefixes are deliberately
# absent — openconnect is not resolved through PATH at all (see OPENCONNECT).
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

# OPENCONNECT is substituted with an absolute path by scripts/install.sh when it
# installs this file. The repo copy keeps the placeholder and refuses to run:
# resolving openconnect at run time (command -v, or a PATH containing a
# user-writable Homebrew prefix) would turn the NOPASSWD rule into passwordless
# root code execution for anyone who can write to that directory.
OPENCONNECT='@OPENCONNECT@'

PIDFILE=/var/run/openfortitray-openconnect.pid
# Seconds to wait for openconnect to exit (restoring routing) after SIGINT.
# internal/tunnel allows a little more than this before giving up on us.
STOP_TIMEOUT=6

die() {
	echo "openfortitray-tunnel: $1" >&2
	exit 1
}

# validate_gateway rejects anything that is not a plain host:port. Without this,
# a caller could smuggle openconnect options (--script=..., --csd-wrapper=...)
# into the argument list and get arbitrary root code execution.
validate_gateway() {
	case "$1" in
	-*) die "gateway must not start with '-'" ;;
	*[!A-Za-z0-9.:_-]*) die "gateway contains invalid characters" ;;
	*:*) ;;
	*) die "gateway must be host:port" ;;
	esac
	_host=${1%:*}
	_port=${1##*:}
	case "$_host" in
	'' | *:*) die "gateway must be host:port" ;;
	esac
	case "$_port" in
	'' | *[!0-9]*) die "gateway port must be numeric" ;;
	esac
}

# validate_fingerprint rejects anything that is not a plausible certificate
# fingerprint. It never leads to code execution — --servercert only pins a cert —
# but a strict charset and length keep the value from being a path or carrying a
# shell metacharacter. Accepts the forms openconnect (and internal/tunnel's
# openconnectFlags) emit: a bare hex string, "sha256:AB:CD:…" byte form, or the
# "pin-sha256:<base64>" pin form (whose base64 may contain + / =). A leading '-'
# would look like a flag and a leading '/' like a path, so both are refused.
validate_fingerprint() {
	_fp=$1
	case "$_fp" in
	'') die "--servercert requires a fingerprint" ;;
	-*) die "--servercert fingerprint must not start with '-'" ;;
	/*) die "--servercert fingerprint must not look like a path" ;;
	*[!A-Za-z0-9:+/=._-]*) die "--servercert fingerprint contains invalid characters" ;;
	esac
	if [ "${#_fp}" -gt 256 ]; then
		die "--servercert fingerprint is too long"
	fi
}

# validate_flags refuses every "start" argument that is not on the exact
# allowlist, BEFORE openconnect (or any pidfile side effect) is reached. This is
# what preserves the "no arbitrary openconnect options" guarantee now that the
# app threads the Advanced toggles through: only --no-dtls, --disable-ipv6 and
# --servercert <fingerprint> pass, and none of them takes a script/command
# openconnect would run as root. Anything else — another flag, --script/
# --csd-wrapper/-o/--, a bare "-x", or --servercert without a valid fingerprint —
# dies. Arguments arrive as distinct argv elements (no shell between the app and
# here), so a fingerprint value can never be re-split into a fresh option.
validate_flags() {
	while [ $# -gt 0 ]; do
		case "$1" in
		--no-dtls | --disable-ipv6)
			shift
			;;
		--servercert)
			shift
			[ $# -ge 1 ] || die "--servercert requires a fingerprint"
			validate_fingerprint "$1"
			shift
			;;
		*)
			die "disallowed openconnect option: '$1' (only --no-dtls, --disable-ipv6, --servercert <fingerprint> are permitted)"
			;;
		esac
	done
}

# running_openconnect_pid echoes the pid from the pidfile if it is a live
# openconnect process, and nothing otherwise (missing, stale or recycled pid).
running_openconnect_pid() {
	[ -f "$PIDFILE" ] || return 0
	pid=$(cat "$PIDFILE" 2>/dev/null) || return 0
	case "$pid" in
	'' | *[!0-9]*) return 0 ;;
	esac
	[ "$pid" -gt 1 ] 2>/dev/null || return 0
	# Never signal a pid the kernel has since handed to something else.
	comm=$(ps -o comm= -p "$pid" 2>/dev/null) || return 0
	case "$comm" in
	*openconnect*) echo "$pid" ;;
	esac
}

# terminate_running interrupts the recorded openconnect, if any, and waits for it
# to go away. Always succeeds: "no tunnel running" is the desired end state.
terminate_running() {
	pid=$(running_openconnect_pid)
	if [ -n "$pid" ]; then
		# SIGINT, not SIGKILL: openconnect only tears the tunnel down and
		# restores the routing table on a clean shutdown.
		kill -INT "$pid" 2>/dev/null || true
		i=0
		while [ "$i" -lt "$STOP_TIMEOUT" ]; do
			kill -0 "$pid" 2>/dev/null || break
			sleep 1
			i=$((i + 1))
		done
		if kill -0 "$pid" 2>/dev/null; then
			# Wedged past the grace period; routing may stay broken, but a live
			# tunnel nobody can control is worse.
			kill -KILL "$pid" 2>/dev/null || true
		fi
	fi
	rm -f "$PIDFILE"
}

# resolve_openconnect echoes the baked-in openconnect path after checking that it
# is still safe to execute as root. See the threat model at the top: on Linux a
# tampered-with binary is fatal, on macOS it is a warning because the Homebrew
# prefix is user-owned by design.
resolve_openconnect() {
	case "$OPENCONNECT" in
	'@OPENCONNECT@' | '')
		die "not installed: run scripts/install.sh, which bakes in the openconnect path" ;;
	/*) ;;
	*) die "openconnect path must be absolute, got '$OPENCONNECT'" ;;
	esac
	[ -x "$OPENCONNECT" ] || die "$OPENCONNECT is missing or not executable"

	# find, not stat: the -perm/-user predicates below behave identically on BSD
	# and GNU find, whereas stat's format flags do not.
	unsafe=''
	if [ -n "$(find "$OPENCONNECT" -maxdepth 0 ! -user root -print 2>/dev/null)" ]; then
		unsafe="not owned by root"
	elif [ -n "$(find "$OPENCONNECT" -maxdepth 0 \( -perm -0020 -o -perm -0002 \) -print 2>/dev/null)" ]; then
		unsafe="writable by group or other"
	fi
	if [ -n "$unsafe" ]; then
		if [ "$(uname -s)" = Darwin ]; then
			echo "openfortitray-tunnel: WARNING: $OPENCONNECT is $unsafe;" \
				"anyone who can write it gains root through this helper" >&2
		else
			die "refusing to run as root: $OPENCONNECT is $unsafe"
		fi
	fi
	echo "$OPENCONNECT"
}

cmd_start() {
	[ $# -ge 1 ] || die "usage: openfortitray-tunnel start <host:port> [flag ...]"
	validate_gateway "$1"
	gateway=$1
	shift
	# Everything after the gateway must be an allowlisted, argument-validated
	# flag. Do this BEFORE resolve_openconnect / terminate_running / the pidfile
	# so a rejected argument has no side effect at all.
	validate_flags "$@"
	oc=$(resolve_openconnect)

	# Adopt-and-replace: if a previous app instance died without stopping its
	# tunnel, that root openconnect is orphaned and unreachable from the tray.
	# Clear it before starting ours, so a crash cannot leave the machine with a
	# tunnel and no way to bring it down.
	terminate_running

	# Record the pid *before* exec: exec replaces this shell in place, so $$
	# becomes openconnect's pid. openconnect's own --pid-file only writes the
	# file when it daemonises (--background), and we deliberately keep it in the
	# foreground so the supervisor can read its progress output and reap it.
	umask 022
	echo $$ >"$PIDFILE" || die "cannot write $PIDFILE"

	# --non-inter: never prompt (there is no tty); --cookie-on-stdin: the cookie
	# arrives on stdin, which sudo passes through, so it stays off the argv and
	# out of the process table. The validated flags ("$@") sit before the gateway,
	# matching the order internal/tunnel builds for the direct path.
	exec "$oc" --protocol=fortinet --cookie-on-stdin --non-inter "$@" "$gateway"
}

cmd_stop() {
	[ $# -eq 0 ] || die "usage: openfortitray-tunnel stop"
	terminate_running
	exit 0 # stop is idempotent: "already gone" is success
}

[ $# -ge 1 ] || die "usage: openfortitray-tunnel {start <host:port>|stop}"
sub=$1
shift
case "$sub" in
start) cmd_start "$@" ;;
stop) cmd_stop "$@" ;;
*) die "unknown subcommand: $sub" ;;
esac
